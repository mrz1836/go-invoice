# BUSINESS_EMAIL="invoices@acmedev.com"
# BUSINESS_TAX_ID="94-1234567"
# PAYMENT_TERMS="Net 15"
# Domestic wire details: supply the WIRE_DOMESTIC_* values via the runtime environment
# INVOICE_PREFIX="ACME"
# INVOICE_START_NUMBER=2024001
