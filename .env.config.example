# --- International Business (UK) ---
# BUSINESS_NAME="Global Tech Solutions Ltd"
# BUSINESS_ADDRESS="10 Downing Street\nLondon SW1A 2AA\nUnited Kingdom"
# BUSINESS_PHONE="+44-20-7123-4567"
# BUSINESS_EMAIL="accounts@globaltech.uk"
# BUSINESS_VAT_ID="GB123456789"
# PAYMENT_TERMS="30 days from invoice date"
# International wire details: supply the WIRE_INTL_* values via the runtime environment
# INVOICE_PREFIX="GTS"
# CURRENCY="GBP"
# VAT_RATE=0.20

# --- Consultant (Hourly Billing) ---
# BUSINESS_NAME="Strategic Consulting Group"
# BUSINESS_ADDRESS="789 Business Park\nAustin, TX 78701"
# BUSINESS_EMAIL="billing@strategicgroup.com"
# BUSINESS_TAX_ID="75-9876543"
# PAYMENT_TERMS="Due within 15 days"
# INVOICE_PREFIX="SCG"
# INVOICE_DUE_DAYS=15
# CURRENCY="USD"

# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. Never commit this file with real credentials to version control
# 2. Keep sensitive information (full account numbers, tax IDs) secure
# 3. Use environment variables for sensitive data when possible
# 4. Supply wire transfer details (WIRE_DOMESTIC_* / WIRE_INTL_*) only through
#    the runtime environment; never store them in this file
# 5. Ensure proper file permissions on your .env.config file (600)
#
# ============================================================================
