# go-invoice Configuration Example
# Copy this file to .env.config and customize for your business

# ============================================================================
# BUSINESS INFORMATION
# ============================================================================

# Required: Your business or personal name
BUSINESS_NAME="John Doe Consulting"

# Required: Your business address (use \n for line breaks if needed)
BUSINESS_ADDRESS="123 Main Street\nSuite 100\nNew York, NY 10001\nUnited States"

# Optional: Business phone number
BUSINESS_PHONE="+1-555-123-4567"

# Required: Business email address for invoicing
BUSINESS_EMAIL="billing@johndoe.com"

# Optional: Tax identification number
BUSINESS_TAX_ID="12-3456789"

# Optional: VAT identification number (for EU businesses)
BUSINESS_VAT_ID="US123456789"

# Optional: Business website
BUSINESS_WEBSITE="https://johndoe.com"

# Required: Default payment terms for invoices
PAYMENT_TERMS="Net 30"

# ============================================================================
# BANKING & PAYMENT INFORMATION
# ============================================================================

# Optional: Custom payment instructions
PAYMENT_INSTRUCTIONS="Wire transfers preferred. Checks payable to John Doe Consulting."

# ============================================================================
# USD WIRE TRANSFER PAYMENT METHODS
# ============================================================================
#
# Two independent wire sets are supported: a domestic (US) set and an
# international set. Each client selects which set appears on its invoices
# with `--wire-type domestic|international|none` on `client create` /
# `client update`, and can opt into a wire service fee with `--wire-fee`
# (`--wire-fee-amount`, default 20.00).
#
# SENSITIVE: beneficiary, bank, account, routing, IBAN, and SWIFT/BIC values
# must be supplied through the runtime environment (exported variables when
# running go-invoice). Never write them into this file or commit them to
# version control. Values already present in the environment take precedence
# over this file.
#
# Generating an invoice for a client whose selected wire set is disabled or
# missing a required field fails with a clear error instead of rendering
# incomplete wire instructions.

# Enable the domestic (US) wire set (default: false)
# WIRE_DOMESTIC_ENABLED=false

# Enable the international wire set (default: false)
# WIRE_INTL_ENABLED=false

# --- Domestic (US) wire set: supply via the runtime environment ---
# Required when enabled: beneficiary, bank name, account, routing, account type, reference
# WIRE_DOMESTIC_BENEFICIARY=""
# WIRE_DOMESTIC_BANK_NAME=""
# WIRE_DOMESTIC_ACCOUNT=""
# WIRE_DOMESTIC_ROUTING=""                 # ABA routing number
# WIRE_DOMESTIC_ACCOUNT_TYPE=""            # e.g. Checking or Savings
# WIRE_DOMESTIC_REFERENCE=""               # Payment reference / memo

# --- International wire set: supply via the runtime environment ---
# Required when enabled: beneficiary + address, bank name + address, SWIFT/BIC,
# reference, and at least one of IBAN or account number.
# The intermediary bank and its SWIFT/BIC are optional, but must be set together.
# WIRE_INTL_BENEFICIARY=""
# WIRE_INTL_BENEFICIARY_ADDRESS=""
# WIRE_INTL_BANK_NAME=""
# WIRE_INTL_BANK_ADDRESS=""
# WIRE_INTL_SWIFT=""                       # SWIFT/BIC code
# WIRE_INTL_IBAN=""                        # IBAN, or use WIRE_INTL_ACCOUNT
# WIRE_INTL_ACCOUNT=""
# WIRE_INTL_INTERMEDIARY_BANK=""           # Optional correspondent bank
# WIRE_INTL_INTERMEDIARY_SWIFT=""          # Required with an intermediary bank
# WIRE_INTL_REFERENCE=""                   # Payment reference / memo

# ============================================================================
# CRYPTOCURRENCY PAYMENT METHODS
# ============================================================================

# Enable USDC payment method
USDC_ENABLED=false

# Optional: USDC cryptocurrency wallet address (Ethereum)
# IMPORTANT: For best results with payment verification, use a unique address
# per invoice (set via --usdc-address flag when creating invoices).
# This address is used as the global default if no per-invoice address is set.
# USDC_ADDRESS="0x742d35Cc6634C0532925a3b844Bc9e7595f0bEb"

# Enable BSV (Bitcoin SV) payment method
# NOTE: BSV payment verification is not yet implemented. Coming soon!
BSV_ENABLED=false

# Optional: BSV (Bitcoin SV) cryptocurrency wallet address
# BSV_ADDRESS="1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa"

# Optional: Etherscan API Key (recommended for USDC payment verification)
# Without an API key, Etherscan rate limits are very strict and may cause errors.
# Free tier: 5 requests/second, 100,000 requests/day
# Get your API key at: https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=""

# ============================================================================
# INVOICE SETTINGS
# ============================================================================

# Required: Invoice number prefix
INVOICE_PREFIX="JDC"

# Invoice starting number (default: 1000)
INVOICE_START_NUMBER=1000

# Optional: Footer text for invoices
INVOICE_FOOTER="Thank you for your business!"

# Required: Currency code (ISO 4217)
CURRENCY="USD"

# VAT/Tax rate as decimal (0.20 = 20%, 0.0 = no tax)
VAT_RATE=0.0

# Default number of days until invoice is due
INVOICE_DUE_DAYS=30

# ============================================================================
# STORAGE SETTINGS
# ============================================================================

# Optional: Custom data directory (default: ~/.go-invoice)
# DATA_DIR="/path/to/custom/invoice/data"

# Optional: Custom backup directory (default: DATA_DIR/backups)
# BACKUP_DIR="/path/to/backups"

# Number of days to retain old data (default: 365)
RETENTION_DAYS=365

# Enable automatic backups (default: false)
AUTO_BACKUP=true

# Backup interval in Go duration format (default: 24h)
BACKUP_INTERVAL=24h

# NOTE: Generated invoices are always saved to DATA_DIR/generated/
# This ensures consistent file locations regardless of how invoices are created.
# Default location: ~/.go-invoice/generated/

# ============================================================================
# EXAMPLE CONFIGURATIONS FOR DIFFERENT USE CASES
# ============================================================================

# --- Freelancer (Minimal Setup) ---
# BUSINESS_NAME="Jane Smith - Web Developer"
# BUSINESS_ADDRESS="Remote"
# BUSINESS_EMAIL="jane@example.com"
# PAYMENT_TERMS="Due upon receipt"
